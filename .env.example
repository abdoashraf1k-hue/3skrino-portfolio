# Copy to .env.local and fill in. Never commit real values.
# `vercel env pull .env.local` fills the Vercel-managed ones.

# --- Admin panel -------------------------------------------------------
# Secret for /admin?key=… and the Authorization header on /api/admin/*
ADMIN_SECRET_KEY=

# GitHub Contents/Git Data API — the admin commits data/projects.ts (+ backups/)
GITHUB_TOKEN=            # fine-grained token: Contents read/write on the repo
GITHUB_REPO=             # owner/repo
GITHUB_BRANCH=main
GITHUB_NAME="3SKRINO Admin"
GITHUB_EMAIL=

# --- Media (Vercel Blob) ------------------------------------------------
# Store "3skrino-videos" (public). Used for client uploads + the storage stats.
BLOB_READ_WRITE_TOKEN=

# --- AI video analysis (Vercel AI Gateway) -------------------------------
# Provided automatically on Vercel / by `vercel env pull` (expires ~12h locally).
# Alternatively set AI_GATEWAY_API_KEY. Without either, the admin falls back to
# keyword-based suggestions.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# --- Contact form (Resend) ----------------------------------------------
# https://resend.com/api-keys — without it /api/contact answers 503.
RESEND_API_KEY=

# --- Analytics ----------------------------------------------------------
# Google Analytics 4 measurement id (G-XXXXXXX). Optional.
NEXT_PUBLIC_GA_ID=

# --- SEO ----------------------------------------------------------------
# Canonical origin for sitemap, RSS, OG and JSON-LD. Defaults to https://3skrino.com
NEXT_PUBLIC_SITE_URL=

# --- Legacy (no longer read by the code; safe to delete) -----------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Copy to .env.local and fill in. Never commit real values.
# `vercel env pull .env.local` fills the Vercel-managed ones.

# --- Admin panel -------------------------------------------------------
# Secret for /admin?key=… and the Authorization header on /api/admin/*
ADMIN_SECRET_KEY=

# GitHub Contents/Git Data API — the admin commits data/projects.ts (+ backups/)
GITHUB_TOKEN=            # fine-grained token: Contents read/write on the repo
GITHUB_REPO=             # owner/repo
GITHUB_BRANCH=main
GITHUB_NAME="3SKRINO Admin"
GITHUB_EMAIL=

# --- Media (Vercel Blob) ------------------------------------------------
# Store "3skrino-videos" (public). Legacy: still serves old URLs, the storage
# stats and the video fallback. Since Sprint 13 no image/logo upload goes here.
BLOB_READ_WRITE_TOKEN=

# --- Media storage (Sprint 12) -------------------------------------------
# Backblaze B2 via its S3-compatible API. The browser uploads straight to B2
# with short-lived presigned URLs minted by /api/admin/b2-upload; visitors get
# /media/<key> → a 15-minute presigned GET, so the bucket can stay PRIVATE.
# B2_* are SERVER-ONLY secrets — never rename them to NEXT_PUBLIC_*.
# Endpoint + region come from the bucket's page in the B2 console; the region
# code (us-west-004, eu-central-003, …) varies per account.
# Values below the "e.g." are this project's (3skrino-videos-2026 bucket).
B2_ENDPOINT=             # e.g. s3.eu-central-003.backblazeb2.com (https:// optional)
B2_REGION=               # optional — derived from B2_ENDPOINT (eu-central-003)
B2_KEY_ID=               # application key ID (scoped to the bucket)
B2_APP_KEY=              # application key (shown once when created)
B2_BUCKET_NAME=          # e.g. 3skrino-videos-2026
# Sprint 13: ALL admin uploads (logos, poses, site images, sounds, thumbnails,
# videos) are presigned PUTs from the browser straight to the bucket. The
# bucket's CORS rules must therefore allow PUT (plus GET/HEAD) from every site
# origin (production, preview, http://localhost:3000) with the Content-Type
# header, and expose ETag. scripts/setup-b2.py sets exactly that rule
# ("admin-uploads": s3_put/s3_get/s3_head, allowedHeaders *, exposeHeaders ETag) —
# re-run it after adding a new origin. Without it the browser PUT fails with a
# CORS error before any byte is sent.
# Only used by scripts/setup-b2.py (one-time CORS + lifecycle setup through B2's
# native API), not by the site. It's the "API Endpoint" on the B2 account page.
B2_API_ENDPOINT=         # e.g. https://api003.backblazeb2.com
# Optional. Leave EMPTY for a private B2 bucket (media is served via /media).
# Set only when the bucket is public behind a CDN (e.g. an R2 custom domain);
# public URLs then become <NEXT_PUBLIC_CDN_URL>/<key>.
NEXT_PUBLIC_CDN_URL=
# Optional. The Cloudflare Worker in front of the private bucket
# (workers/b2-proxy/worker.js), e.g. https://3skrino-b2-proxy.<you>.workers.dev
# B2 videos then play from <proxy>/<key> and are cached at Cloudflare's edge.
# Stored URLs never change: clear this and redeploy to go back to /media.
NEXT_PUBLIC_B2_PROXY_URL=
# Optional default for new video uploads: b2 | vercel-blob. Without it the
# admin uses "auto" (b2 when the B2_* vars are set, else Vercel Blob).
# admin → Settings → Storage overrides it.
NEXT_PUBLIC_STORAGE_PROVIDER=

# --- AI video analysis (Vercel AI Gateway) -------------------------------
# Provided automatically on Vercel / by `vercel env pull` (expires ~12h locally).
# Alternatively set AI_GATEWAY_API_KEY. Without either, the admin falls back to
# keyword-based suggestions.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# --- AI angle generator (Sprint 14, Replicate) ---------------------------
# admin → Poses → AI Reality Engine → "Generate Missing Angles" calls
# /api/ai/generate-angles, which runs a LivePortrait head-pose editor on
# Replicate (paid per prediction). https://replicate.com/account/api-tokens
# Server-only — never NEXT_PUBLIC_*. Without it the button answers 503.
REPLICATE_API_TOKEN=
# Optional: a different version of fofr/expression-editor (or any model with
# the same inputs: image, rotate_yaw, rotate_pitch, rotate_roll).
REPLICATE_ANGLE_VERSION=

# --- Contact form (Resend) ----------------------------------------------
# https://resend.com/api-keys — without it /api/contact answers 503.
RESEND_API_KEY=

# --- Analytics ----------------------------------------------------------
# Google Analytics 4 measurement id (G-XXXXXXX). Optional.
NEXT_PUBLIC_GA_ID=

# --- Admin control center (all optional) --------------------------------
# Vercel access token + project id: the Analytics tab (Web Analytics API),
# dashboard view counts, and one-click admin-key rotation. Add VERCEL_TEAM_ID
# when the project belongs to a team.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# A Vercel deploy hook URL — rotation redeploys so the new key goes live.
VERCEL_DEPLOY_HOOK_URL=
# Scheduled backups (vercel.json cron → /api/cron/backup). Vercel sends it as
# "Authorization: Bearer $CRON_SECRET"; the route refuses to run without it.
CRON_SECRET=

# --- Site origin ----------------------------------------------------------
# Canonical origin for sitemap, RSS, OG and JSON-LD — and the base of every
# stored B2 video URL (<origin>/media/<key>). Defaults to https://3skrino.com,
# which must actually serve this site; until that domain is live set it to
# https://3skrino-portfolio.vercel.app. Always the production https:// origin,
# also locally (an http://localhost value makes project saves fail).
NEXT_PUBLIC_SITE_URL=

# --- Legacy (no longer read by the code; safe to delete) -----------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
